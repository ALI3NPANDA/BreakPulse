<Window x:Class="BreakPulse.Views.BreakOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Break Time"
        WindowState="Maximized"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Grid>
        <Rectangle Fill="#D9080812"/>

        <!-- Close button (top-right) -->
        <Button x:Name="CloseBtn"
                Content="✖"
                Width="36" Height="36"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,32,32,0"
                Style="{StaticResource PillButton}"
                Click="CloseBtn_Click"
                ToolTip="Skip break"/>

        <!-- Central card -->
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="360"
                Background="#FF15141F"
                BorderBrush="#44FFFFFF"
                BorderThickness="0.5"
                CornerRadius="24"
                Padding="40,36">
            <StackPanel>

                <!-- Icon -->
                <Image Source="/Assets/emoji_meditate.png"
                       Width="52" Height="52"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,16"
                       RenderOptions.BitmapScalingMode="HighQuality"/>

                <!-- Title -->
                <TextBlock x:Name="TitleLabel"
                           FontFamily="Segoe UI Emoji, Segoe UI"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="#FFF0EFF5"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>

                <!-- Message -->
                <TextBlock x:Name="MessageLabel"
                           FontFamily="Segoe UI Emoji, Segoe UI"
                           FontSize="14"
                           Foreground="#FF9997AA"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           LineHeight="22"
                           Margin="0,0,0,28"/>

                <!-- Break countdown -->
                <TextBlock x:Name="CountdownLabel"
                           FontFamily="Cascadia Code, JetBrains Mono, Consolas"
                           FontSize="18"
                           Foreground="#FF6C63FF"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,28"/>

                <!-- Stretch suggestion -->
                <Border Background="#12FFFFFF"
                        CornerRadius="10"
                        Padding="16,12"
                        Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock x:Name="ExerciseLabel"
                                   FontFamily="Segoe UI Emoji, Segoe UI"
                                   FontSize="13"
                                   Foreground="#FF9997AA"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Action buttons -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,0">

                    <Button x:Name="SnoozeBtn"
                            Content="Snooze ⏰"
                            Width="130" Height="36"
                            Margin="0,0,10,0"
                            Style="{StaticResource PillButton}"
                            Click="Snooze_Click"/>

                    <Button x:Name="Continue"
                            Content="End Break Early"
                            Width="140" Height="36"
                            Style="{StaticResource AccentButton}"
                            Click="Continue_Click"/>
                </StackPanel>

                <!-- Dismiss shortcut hint (shown when RequireShortcut=true) -->
                <TextBlock x:Name="ShortcutHint"
                           Text="Press Ctrl+Shift+B to dismiss"
                           FontFamily="Segoe UI"
                           FontSize="11"
                           Foreground="#FF5C5A6E"
                           HorizontalAlignment="Center"
                           Margin="0,14,0,0"
                           Visibility="Collapsed"/>
            </StackPanel>
        </Border>
    <!-- (removed extra closing Grid tag) -->
    </Grid>
</Window>
