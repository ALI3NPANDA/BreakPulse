<Window x:Class="BreakPulse.Views.BreakOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Break Time"
        Width="500" Height="500"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Opacity="100">

    <!-- Drag the window by clicking the circle -->
    <Grid MouseDown="OnMouseDown">

        <!-- Outer glow ring -->
        <Ellipse Width="500" Height="500"
                 Fill="Transparent"
                 Stroke="#18FFFFFF"
                 StrokeThickness="2"/>

        <!-- Background circle with accent-tinted radial gradient -->
        <Ellipse Width="460" Height="460"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center">
            <Ellipse.Fill>
                <RadialGradientBrush x:Name="BgCircleBrush">
                    <GradientStop Color="#FF6C63FF" Offset="0.2"/>
                    <GradientStop Color="#FF00E5A0" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- Accent color glow (top bloom) 
        <Ellipse Width="500" Height="500"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Margin="0,0,0,0"
                 Opacity="0.18">
            <Ellipse.Fill>
                <RadialGradientBrush x:Name="AccentGlowBrush">
                    <GradientStop Color="#FF6C63FF" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        -->

        <!-- Progress arc canvas — break countdown ring -->
        <Canvas Width="460" Height="460"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Path x:Name="ArcTrack"
                  Stroke="#14FFFFFF"
                  StrokeThickness="4"
                  Fill="Transparent"/>
            <Path x:Name="ArcFill"
                  StrokeThickness="4"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  Fill="Transparent">
                <Path.Stroke>
                    <SolidColorBrush x:Name="ArcBrush" Color="#FF6C63FF"/>
                </Path.Stroke>
            </Path>
        </Canvas>

        <!-- Inner border ring -->
        <Ellipse Width="500" Height="500"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Fill="Transparent"
                 Stroke="#18FFFFFF"
                 StrokeThickness="0.5"/>

        <!-- ── Central content ─────────────────────────────────── -->
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="300">

            <!-- Emoji icon -->
            <ContentControl x:Name="IconViewHost"
                            Width="64" Height="64"
                            HorizontalAlignment="Center"
                            IsHitTestVisible="False"
                            Margin="0,0,0,8"/>

            <!-- Title -->
            <ContentControl x:Name="TitleViewHost"
                            Height="32"
                            HorizontalAlignment="Stretch"
                            IsHitTestVisible="False"
                            Margin="0,0,0,4"/>

            <!-- Big break countdown -->
            <TextBlock x:Name="CountdownLabel"
                       FontFamily="Cascadia Code, JetBrains Mono, Consolas"
                       FontSize="30"
                       FontWeight="SemiBold"
                       Foreground="#FFFFFFFF"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,12"/>

            <TextBlock x:Name="RemainingLabel"
                       Text="Remaining"
                       FontFamily="Segoe UI"
                       FontSize="15"
                       FontWeight="Medium"
                       Foreground="#FF5C5A6E"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,12"
                       TextOptions.TextFormattingMode="Display"/>

            <!-- Stretch suggestion card -->
            <Border x:Name="ExerciseCard"
                    Background="#12FFFFFF"
                    CornerRadius="10"
                    Padding="12,8"
                    Margin="0,0,0,14">
                <ContentControl x:Name="ExerciseViewHost"
                                Height="100"
                                IsHitTestVisible="False"/>
            </Border>

            <!-- Action buttons -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">
                <Button x:Name="SnoozeBtn"
                        Content="Snooze ⏰"
                        Width="115" Height="34"
                        Margin="0,0,8,0"
                        Style="{StaticResource PillButton}"
                        Click="Snooze_Click"/>
                <Button x:Name="Continue"
                        Content="End Break Early"
                        Width="130" Height="34"
                        Style="{StaticResource AccentButton}"
                        Click="Continue_Click"/>
            </StackPanel>

            <!-- Shortcut hint (RequireShortcut mode) -->
            <TextBlock x:Name="ShortcutHint"
                       Text="Press Ctrl+Shift+B to dismiss"
                       FontFamily="Segoe UI"
                       FontSize="11"
                       Foreground="#FF5C5A6E"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,0"
                       Visibility="Collapsed"/>
        </StackPanel>

        <!-- Context menu -->
        <Grid.ContextMenu>
            <ContextMenu Background="#FF15141F"
                         BorderBrush="#22FFFFFF"
                         Foreground="#FFF0EFF5"
                         FontFamily="Segoe UI"
                         FontSize="13">
                <MenuItem x:Name="MenuSnooze"    Header="Snooze" Click="MenuSnooze_Click"/>
                <MenuItem x:Name="MenuEndBreak"  Header="End Break"    Click="MenuEndBreak_Click"/>
            </ContextMenu>
        </Grid.ContextMenu>
    </Grid>
</Window>
