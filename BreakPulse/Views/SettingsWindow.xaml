<Window x:Class="BreakPulse.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BreakPulse — Settings"
        Width="520" Height="600"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize"
        Background="#FF0E0E10"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Text="Settings"
                   Style="{StaticResource H1}"
                   Margin="0,0,0,16"/>

        <!-- Tab control -->
        <TabControl Grid.Row="1"
                    Background="#FF12121A"
                    BorderBrush="#22FFFFFF"
                    BorderThickness="0.5">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Background"   Value="Transparent"/>
                    <Setter Property="Foreground"   Value="#FF9997AA"/>
                    <Setter Property="Padding"      Value="14,8"/>
                    <Setter Property="FontFamily"   Value="Segoe UI"/>
                    <Setter Property="FontSize"     Value="12"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="#FFF0EFF5"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TabControl.Resources>

            <!-- ── Timer tab ──────────────────────────────────────────── -->
            <TabItem Header="Timer">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel>
                        <TextBlock Text="WORK SESSION" Style="{StaticResource Body}" FontSize="10" Margin="0,0,0,10"/>

                        <StackPanel Margin="0,0,0,14">
                            <DockPanel><TextBlock Text="Session length" Style="{StaticResource Body}" Width="160"/><TextBlock x:Name="SessionVal" Style="{StaticResource Mono}" DockPanel.Dock="Right" Text="60 min"/></DockPanel>
                            <Slider x:Name="SessionSlider" Minimum="1" Maximum="120" TickFrequency="5" IsSnapToTickEnabled="True" Style="{StaticResource ThinSlider}" ValueChanged="SessionSlider_ValueChanged"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,14">
                            <DockPanel><TextBlock Text="Break duration" Style="{StaticResource Body}" Width="160"/><TextBlock x:Name="BreakVal" Style="{StaticResource Mono}" DockPanel.Dock="Right" Text="5 min"/></DockPanel>
                            <Slider x:Name="BreakSlider" Minimum="1" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True" Style="{StaticResource ThinSlider}" ValueChanged="BreakSlider_ValueChanged"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,14">
                            <DockPanel><TextBlock Text="Long break every" Style="{StaticResource Body}" Width="160"/><TextBlock x:Name="LongBreakVal" Style="{StaticResource Mono}" DockPanel.Dock="Right" Text="3 sessions"/></DockPanel>
                            <Slider x:Name="LongBreakSlider" Minimum="2" Maximum="6" TickFrequency="1" IsSnapToTickEnabled="True" Style="{StaticResource ThinSlider}" ValueChanged="LongBreakSlider_ValueChanged"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,14">
                            <DockPanel><TextBlock Text="Long break duration" Style="{StaticResource Body}" Width="160"/><TextBlock x:Name="LongBreakDurVal" Style="{StaticResource Mono}" DockPanel.Dock="Right" Text="15 min"/></DockPanel>
                            <Slider x:Name="LongBreakDurSlider" Minimum="5" Maximum="30" TickFrequency="5" IsSnapToTickEnabled="True" Style="{StaticResource ThinSlider}" ValueChanged="LongBreakDurSlider_ValueChanged"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,14">
                            <DockPanel><TextBlock Text="Pre-warning" Style="{StaticResource Body}" Width="160"/><TextBlock x:Name="PreWarnVal" Style="{StaticResource Mono}" DockPanel.Dock="Right" Text="2 min"/></DockPanel>
                            <Slider x:Name="PreWarnSlider" Minimum="0" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" Style="{StaticResource ThinSlider}" ValueChanged="PreWarnSlider_ValueChanged"/>
                        </StackPanel>

                        <TextBlock Text="SMART SCHEDULING" Style="{StaticResource Body}" FontSize="10" Margin="0,10,0,10"/>

                        <DockPanel Margin="0,0,0,10"><TextBlock Text="Skip during meetings" Style="{StaticResource Body}"/><ToggleButton x:Name="SkipMeetingsToggle" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}"/></DockPanel>
                        <DockPanel Margin="0,0,0,10"><TextBlock Text="Detect idle time" Style="{StaticResource Body}"/><ToggleButton x:Name="IdleToggle" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}"/></DockPanel>
                        <DockPanel Margin="0,0,0,10"><TextBlock Text="Adaptive breaks" Style="{StaticResource Body}"/><ToggleButton x:Name="AdaptiveToggle" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}"/></DockPanel>
                        <DockPanel Margin="0,0,0,10"><TextBlock Text="Auto-resume after break" Style="{StaticResource Body}"/><ToggleButton x:Name="AutoResumeToggle" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}"/></DockPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ── Alerts tab ─────────────────────────────────────────── -->
            <TabItem Header="Alerts">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel>
                        <TextBlock Text="NOTIFICATION STYLE" Style="{StaticResource Body}" FontSize="10" Margin="0,0,0,10"/>

                        <DockPanel Margin="0,0,0,14">
                            <TextBlock Text="Mode" Style="{StaticResource Body}" Width="160"/>
                            <ComboBox x:Name="AlertModeCombo" DockPanel.Dock="Right" Width="160"
                                      Background="#FF1E1D2A" Foreground="#FFF0EFF5"
                                      BorderBrush="#22FFFFFF">
                                <ComboBoxItem Content="Full overlay" Tag="Overlay"/>
                                <ComboBoxItem Content="HUD pulse only" Tag="HudPulse"/>
                                <ComboBoxItem Content="Sound + HUD" Tag="SoundAndHud"/>
                                <ComboBoxItem Content="Gentle fade" Tag="GentleFade"/>
                            </ComboBox>
                        </DockPanel>

                        <TextBlock Text="BREAK MESSAGE" Style="{StaticResource Body}" FontSize="10" Margin="0,10,0,10"/>

                        <TextBox x:Name="BreakMessageBox"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Height="72"
                                 Background="#FF1E1D2A"
                                 Foreground="#FFF0EFF5"
                                 BorderBrush="#22FFFFFF"
                                 BorderThickness="0.5"
                                 Padding="10,8"
                                 FontSize="13"
                                 Margin="0,0,0,14"/>

                        <TextBlock Text="BEHAVIOUR" Style="{StaticResource Body}" FontSize="10" Margin="0,0,0,10"/>

                        <DockPanel Margin="0,0,0,10"><TextBlock Text="Play a sound on break" Style="{StaticResource Body}"/><ToggleButton x:Name="SoundToggle" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}"/></DockPanel>
                        <DockPanel Margin="0,0,0,10"><TextBlock Text="Require Ctrl+Shift+B to dismiss" Style="{StaticResource Body}"/><ToggleButton x:Name="ShortcutToggle" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}"/></DockPanel>
                        <DockPanel Margin="0,0,0,10"><TextBlock Text="Block screen during break" Style="{StaticResource Body}"/><ToggleButton x:Name="BlockScreenToggle" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}"/></DockPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ── Display tab ────────────────────────────────────────── -->
            <TabItem Header="Display">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel>
                        <TextBlock Text="HUD" Style="{StaticResource Body}" FontSize="10" Margin="0,0,0,10"/>

                        <DockPanel Margin="0,0,0,14">
                            <TextBlock Text="Position" Style="{StaticResource Body}" Width="160"/>
                            <ComboBox x:Name="PositionCombo" DockPanel.Dock="Right" Width="160"
                                      Background="#FF1E1D2A" Foreground="#FFF0EFF5" BorderBrush="#22FFFFFF">
                                <ComboBoxItem Content="Center"       Tag="Center"/>
                                <ComboBoxItem Content="Top right"    Tag="TopRight"/>
                                <ComboBoxItem Content="Bottom right" Tag="BottomRight"/>
                                <ComboBoxItem Content="Top center"   Tag="TopCenter"/>
                            </ComboBox>
                        </DockPanel>

                        <StackPanel Margin="0,0,0,14">
                            <DockPanel><TextBlock Text="HUD size" Style="{StaticResource Body}" Width="160"/><TextBlock x:Name="SizeVal" Style="{StaticResource Mono}" DockPanel.Dock="Right" Text="160 px"/></DockPanel>
                            <Slider x:Name="SizeSlider" Minimum="80" Maximum="220" TickFrequency="10" IsSnapToTickEnabled="True" Style="{StaticResource ThinSlider}" ValueChanged="SizeSlider_ValueChanged"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,14">
                            <DockPanel><TextBlock Text="Idle opacity" Style="{StaticResource Body}" Width="160"/><TextBlock x:Name="OpacityVal" Style="{StaticResource Mono}" DockPanel.Dock="Right" Text="90%"/></DockPanel>
                            <Slider x:Name="OpacitySlider" Minimum="10" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Style="{StaticResource ThinSlider}" ValueChanged="OpacitySlider_ValueChanged"/>
                        </StackPanel>

                        <TextBlock Text="VISIBILITY" Style="{StaticResource Body}" FontSize="10" Margin="0,10,0,10"/>

                        <DockPanel Margin="0,0,0,10"><TextBlock Text="Show progress arc" Style="{StaticResource Body}"/><ToggleButton x:Name="ArcToggle" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}"/></DockPanel>
                        <DockPanel Margin="0,0,0,10"><TextBlock Text="Collapse to dot when focused" Style="{StaticResource Body}"/><ToggleButton x:Name="DotToggle" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}"/></DockPanel>
                        <DockPanel Margin="0,0,0,10"><TextBlock Text="Always on top" Style="{StaticResource Body}"/><ToggleButton x:Name="TopMostToggle" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}"/></DockPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ── Team tab ───────────────────────────────────────────── -->
            <TabItem Header="Team">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel>
                        <TextBlock Text="ENTERPRISE TELEMETRY" Style="{StaticResource Body}" FontSize="10" Margin="0,0,0,10"/>

                        <DockPanel Margin="0,0,0,10"><TextBlock Text="Enable team telemetry" Style="{StaticResource Body}"/><ToggleButton x:Name="TelemetryToggle" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}"/></DockPanel>

                        <TextBlock Text="API Endpoint" Style="{StaticResource Body}" Margin="0,10,0,4"/>
                        <TextBox x:Name="ApiEndpointBox" Background="#FF1E1D2A" Foreground="#FFF0EFF5" BorderBrush="#22FFFFFF" BorderThickness="0.5" Padding="10,7" FontSize="13" Margin="0,0,0,10"/>

                        <TextBlock Text="API Key" Style="{StaticResource Body}" Margin="0,0,0,4"/>
                        <PasswordBox x:Name="ApiKeyBox" Background="#FF1E1D2A" Foreground="#FFF0EFF5" BorderBrush="#22FFFFFF" BorderThickness="0.5" Padding="10,7" FontSize="13" Margin="0,0,0,10"/>

                        <TextBlock Text="Your display name" Style="{StaticResource Body}" Margin="0,0,0,4"/>
                        <TextBox x:Name="DisplayNameBox" Background="#FF1E1D2A" Foreground="#FFF0EFF5" BorderBrush="#22FFFFFF" BorderThickness="0.5" Padding="10,7" FontSize="13" Margin="0,0,0,10"/>

                        <TextBlock Text="Team name" Style="{StaticResource Body}" Margin="0,0,0,4"/>
                        <TextBox x:Name="TeamNameBox" Background="#FF1E1D2A" Foreground="#FFF0EFF5" BorderBrush="#22FFFFFF" BorderThickness="0.5" Padding="10,7" FontSize="13" Margin="0,0,0,14"/>

                        <TextBlock Text="PRIVACY" Style="{StaticResource Body}" FontSize="10" Margin="0,0,0,10"/>
                        <DockPanel Margin="0,0,0,10"><TextBlock Text="Anonymize telemetry" Style="{StaticResource Body}"/><ToggleButton x:Name="AnonToggle" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}"/></DockPanel>
                        <DockPanel Margin="0,0,0,10"><TextBlock Text="Manager dashboard access" Style="{StaticResource Body}"/><ToggleButton x:Name="ManagerToggle" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}"/></DockPanel>
                        <DockPanel Margin="0,0,0,10"><TextBlock Text="Push alerts to Slack / Teams" Style="{StaticResource Body}"/><ToggleButton x:Name="SlackToggle" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}"/></DockPanel>

                        <Button Content="Test connection ↗"
                                Style="{StaticResource PillButton}"
                                HorizontalAlignment="Left"
                                Margin="0,10,0,0"
                                Click="TestConnection_Click"/>
                        <TextBlock x:Name="ConnTestResult" Style="{StaticResource Body}" Margin="0,8,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Footer buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Style="{StaticResource PillButton}" Width="90" Margin="0,0,10,0" Click="Cancel_Click"/>
            <Button Content="Save"   Style="{StaticResource AccentButton}" Width="90" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
