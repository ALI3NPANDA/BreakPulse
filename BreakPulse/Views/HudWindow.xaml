<Window x:Class="BreakPulse.Views.HudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BreakPulse"
        Width="200" Height="200"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Progress arc is drawn via a VisualBrush trick using a Path with a Stroke -->
    </Window.Resources>

    <!-- Drag the window by clicking the circle -->
    <Grid MouseDown="OnMouseDown">

        <!-- Outer glow ring (subtle) -->
        <Ellipse Width="200" Height="200"
                 Fill="Transparent"
                 Stroke="#18FFFFFF"
                 StrokeThickness="2"/>

        <!-- Background circle -->
        <Ellipse Width="164" Height="164"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center">
            <Ellipse.Fill>
                <SolidColorBrush Color="#F00E0E10"/>
            </Ellipse.Fill>
        </Ellipse>

        <!-- Progress arc — drawn as a Canvas with a custom PathGeometry -->
        <Canvas Width="164" Height="164"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Path x:Name="ArcTrack"
                  Stroke="#14FFFFFF"
                  StrokeThickness="3"
                  Fill="Transparent"
                  Canvas.Left="6" Canvas.Top="6"/>
            <Path x:Name="ArcFill"
                  StrokeThickness="3"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  Fill="Transparent"
                  Canvas.Left="6" Canvas.Top="6">
                <Path.Stroke>
                    <SolidColorBrush x:Name="ArcBrush" Color="#FF6C63FF"/>
                </Path.Stroke>
            </Path>
        </Canvas>

        <!-- Border ring -->
        <Ellipse Width="162" Height="162"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Fill="Transparent"
                 Stroke="#18FFFFFF"
                 StrokeThickness="0.5"/>

        <!-- Status dot (top-right) -->
        <Ellipse x:Name="StatusDot"
                 Width="8" Height="8"
                 Fill="#FF00E5A0"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Top"
                 Margin="0,22,22,0"/>

        <!-- Content -->
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False">

            <TextBlock x:Name="TimeLabel"
                       Text="59:00"
                       FontFamily="Cascadia Code, JetBrains Mono, Consolas"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Foreground="#FFF0EFF5"
                       HorizontalAlignment="Center"/>

            <TextBlock x:Name="SubLabel"
                       Text="until break"
                       FontFamily="Segoe UI"
                       FontSize="9"
                       FontWeight="Medium"
                       Foreground="#FF5C5A6E"
                       HorizontalAlignment="Center"
                       Margin="0,3,0,0"
                       TextOptions.TextFormattingMode="Display"/>
        </StackPanel>

        <!-- Context menu -->
        <Grid.ContextMenu>
            <ContextMenu Background="#FF15141F"
                         BorderBrush="#22FFFFFF"
                         Foreground="#FFF0EFF5"
                         FontFamily="Segoe UI"
                         FontSize="13">
                <MenuItem x:Name="MenuPause"   Header="Pause"         Click="MenuPause_Click"/>
                <MenuItem x:Name="MenuBreak"   Header="Take break now" Click="MenuBreak_Click"/>
                <MenuItem x:Name="MenuSettings" Header="Settings"      Click="MenuSettings_Click"/>
            </ContextMenu>
        </Grid.ContextMenu>
    </Grid>
</Window>
