<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net9.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
        <AssemblyName>BreakPulse</AssemblyName>
        <RootNamespace>BreakPulse</RootNamespace>
        <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
        <Version>1.0.0</Version>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
        <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
        <PackageReference Include="System.Drawing.Common" Version="10.0.8" />
        <PackageReference Include="System.Text.Json" Version="9.0.0" />
        <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.0" />
    </ItemGroup>

    <ItemGroup>
        <!-- Tray icon and break overlay icon -->
        <Resource Include="Assets\icon.ico" Condition="Exists('Assets\icon.ico')" />
        <!-- Copy icon to output directory for runtime loading -->
        <None Include="Assets\icon.ico" CopyToOutputDirectory="PreserveNewest" />
        <!-- Copy PNG images to output directory -->
        <None Include="Assets\png\*.png" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="System.Windows.Forms" Version="4.0.0" />
    </ItemGroup>

</Project>
